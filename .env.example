# CYBEORCH — copy to .env (do not commit)

# Admin panel URL path segment (appended before each admin PHP file).
# Examples: admin → /admin/dashboard.php | panel → /panel/dashboard.php
# Leave empty when the web root points directly at the admin/ folder.
ADMIN_BASE_PATH=admin

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=cybeorch_db
DB_CHARSET=utf8mb4

# SMTP / email
EMAIL_USER=info@yourdomain.com
EMAIL_PASS=your_email_password
SMTP_HOST=smtp.stackmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_FROM_NAME=CYBEORCH LABS
SMTP_FROM_EMAIL=info@yourdomain.com
# Optional SMTP troubleshooting (writes PHPMailer debug to logs/mail.log; use 2 for verbose SMTP transcript)
CYBEORCH_SMTP_DEBUG=0
# Public URL embedded in password-reset emails (required on production; not localhost)
CYBEORCH_SITE_URL=https://yourdomain.com
# Public certificate verification URL (used in QR codes on certificates)
CERTIFICATE_VERIFY_URL=https://cybeorch.com/verify-certificate
# Optional: Gmail SMTP for admin password reset (16-char App Password) — best deliverability to Gmail
# ADMIN_RESET_EMAIL_USER=akshataingale2003@gmail.com
# ADMIN_RESET_EMAIL_PASS=your16letterapppassword
# Optional: set to 1 only if SSL handshake fails on local XAMPP
# CYBEORCH_SMTP_INSECURE_SSL=0

# Admin notifications
ADMIN_EMAIL=akshataingale2003@gmail.com

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_CURRENCY=INR

# INR per 1 USD for automatic course/webinar USD fee display (e.g. 94.988 → ₹37,909 ≈ $399)
CYBEORCH_INR_PER_USD=94.988

# Manual bank / UPI (secure-payment.php)
PAYMENT_ACCOUNT_NAME=CYBEORCH LABS
PAYMENT_BANK_NAME=HDFC Bank
PAYMENT_ACCOUNT_NUMBER=50200012345678
PAYMENT_IFSC=HDFC0001234
PAYMENT_ACCOUNT_TYPE=Current
PAYMENT_BRANCH=Mumbai, India
PAYMENT_UPI_ID=cybeorch@hdfcbank

# PhonePe gateway (optional)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=

# Google OAuth — redirect URI: {SITE_URL}/oauth-callback.php
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Comma-separated domains allowed for company email sign-in
REGISTER_COMPANY_EMAIL_DOMAINS=cybeorch.com
